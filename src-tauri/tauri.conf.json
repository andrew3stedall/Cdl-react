{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Castle Draft League",
  "version": "0.1.0",
  "identifier": "com.castledraftleague.app",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix frontend install --no-audit --no-fund && npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Castle Draft League",
        "width": 390,
        "height": 844,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../frontend/public/pwa-192.png",
      "../frontend/public/pwa-512.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
